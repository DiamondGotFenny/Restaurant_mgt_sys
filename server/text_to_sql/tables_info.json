{
  "tables": [
    {
      "name": "restaurant_inspections",
      "description": "Contains restaurant inspection records, violations, and health grades",
      "table_aliases": "ri",
      "columns": [
        {
          "name": "id",
          "type": "SERIAL",
          "description": "Primary key",
          "examples": [1, 2, 3]
        },
        {
          "name": "camis",
          "type": "VARCHAR(8)",
          "description": "Restaurant identifier",
          "examples": ["41446753", "41086655", "50079981"]
        },
        {
          "name": "dba",
          "type": "VARCHAR(255)",
          "description": "Business name",
          "examples": ["TASTY GRILL", "SCOOPS", "THE COPPER STILL"]
        },
        {
          "name": "boro",
          "type": "VARCHAR(50)",
          "description": "Borough location",
          "examples": ["Queens", "Brooklyn", "Manhattan"]
        },
        {
          "name": "building",
          "type": "VARCHAR(50)",
          "description": "Building number",
          "examples": ["1422", "624", "206"]
        },
        {
          "name": "street",
          "type": "VARCHAR(255)",
          "description": "Street name",
          "examples": ["150 STREET", "FLATBUSH AVENUE", "7 AVENUE"]
        },
        {
          "name": "zipcode",
          "type": "VARCHAR(10)",
          "description": "ZIP code",
          "examples": ["", "11225", "10011"]
        },
        {
          "name": "phone",
          "type": "VARCHAR(15)",
          "description": "Phone number",
          "examples": ["7187677200", "7182825904", "6465968975"]
        },
        {
          "name": "cuisine_description",
          "type": "VARCHAR(100)",
          "description": "Type of cuisine",
          "examples": ["Greek", "Vegetarian", ""]
        },
        {
          "name": "inspection_date",
          "type": "DATE",
          "description": "Date of inspection",
          "examples": ["2023-10-24", null, "2023-09-05"]
        },
        {
          "name": "action",
          "type": "TEXT",
          "description": "Action taken after inspection",
          "examples": [
            "Violations were cited in the following area(s).",
            "",
            "No violations were recorded at the time of this inspection."
          ]
        },
        {
          "name": "violation_code",
          "type": "VARCHAR(10)",
          "description": "Code of violation",
          "examples": ["20-06", "02B", null]
        },
        {
          "name": "violation_description",
          "type": "TEXT",
          "description": "Description of violation",
          "examples": [
            "Current letter grade or Grade Pending card not posted",
            "Hot TCS food item not held at or above 140 °F.",
            null
          ]
        },
        {
          "name": "critical_flag",
          "type": "VARCHAR(20)",
          "description": "Whether violation is critical",
          "examples": ["Not Critical", "Critical", "Not Applicable"]
        },
        {
          "name": "score",
          "type": "INTEGER",
          "description": "Inspection score",
          "examples": [null, 28, 0]
        },
        {
          "name": "grade",
          "type": "VARCHAR(1)",
          "description": "Inspection grade",
          "examples": ["A", null, "N"]
        },
        {
          "name": "grade_date",
          "type": "DATE",
          "description": "Inspection grade date",
          "examples": ["2022-09-14", null, "2024-02-14"]
        },
        {
          "name": "latitude",
          "type": "DOUBLE PRECISION",
          "description": "Location latitude",
          "examples": [40.788288140134, 40.658160510787, 40.743296351728]
        },
        {
          "name": "longitude",
          "type": "DOUBLE PRECISION",
          "description": "Location longitude",
          "examples": [-73.813615515673, -73.96045484422, -73.996232400573]
        },
        {
          "name": "record_date",
          "type": "DATE",
          "description": "date the record was added",
          "examples": ["2022-09-14", null, "2024-02-14"]
        }
      ]
    },
